# 复制成 keystore.properties 并填上自己的签名信息（这个文件已被 .gitignore 忽略）。
#
# 没有的话也能构建，只是 release 包会用 debug 签名 —— 能装、能用，但换签名后
# 覆盖安装会失败，需要先卸载。要长期发版就自己建一个：
#
#   keytool -genkeypair -v -keystore clearapp.jks -alias clearapp \
#     -keyalg RSA -keysize 2048 -validity 10950

storeFile=clearapp.jks
storePassword=
keyAlias=clearapp
keyPassword=
